# =============================================================================
# SISTEMA RIS/PACS — Environment Variables (example)
# Copie este arquivo para .env e preencha. NUNCA commite o .env real.
# =============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost

# ── Database (Postgres LOCAL no docker — padrão, sem internet) ──────────────
# O compose sobe um Postgres local (serviço `postgres`). Defina uma senha forte:
#   POSTGRES_PASSWORD=$(node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))")
POSTGRES_DB=ris_pacs
POSTGRES_USER=ris
POSTGRES_PASSWORD=GERE_UMA_SENHA_FORTE
# Usado pelos SCRIPTS do host (node scripts/...). O container do backend recebe
# DATABASE_URL apontando para `postgres:5432` via docker-compose (override).
DATABASE_URL=postgresql://ris:GERE_UMA_SENHA_FORTE@localhost:5432/ris_pacs?sslmode=disable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
# Alternativa em nuvem (Neon): aponte DATABASE_URL para o host .neon.tech com
# ?sslmode=require — o driver liga o SSL automaticamente para neon/RDS.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/ris_pacs?sslmode=require

# ── Redis (containerizado) ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT RS256 ───────────────────────────────────────────────────────────────
# Instalação nova: `bash scripts/setup.sh` gera TODOS os segredos deste arquivo.
# Manual: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out priv.pem
#         openssl pkey -in priv.pem -pubout -out pub.pem   (cole com \n literais)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_AQUI\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nCOLE_AQUI\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Criptografia LGPD (AES-256-GCM) ─────────────────────────────────────────
# gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=64_HEX_CHARS_HERE_______________________________________________
KEY_ENCRYPTION_KEY=64_HEX_CHARS_HERE___________________________________________

# ── RustFS (object storage — containerizado) ────────────────────────────────
# ACCESS_KEY/SECRET_KEY valem para o container do RustFS E para o backend (uma
# fonte só — o compose repassa estes mesmos valores). Gere com:
#   RUSTFS_ACCESS_KEY: node -e "console.log(require('crypto').randomBytes(10).toString('hex'))"
#   RUSTFS_SECRET_KEY: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Os buckets abaixo são criados automaticamente pelo backend no boot.
RUSTFS_ENDPOINT=rustfs
RUSTFS_PORT=9000
RUSTFS_USE_SSL=false
RUSTFS_ACCESS_KEY=GERE_UMA_CHAVE
RUSTFS_SECRET_KEY=GERE_UM_SEGREDO_FORTE
RUSTFS_BUCKET_DICOM=pacs-dicom
RUSTFS_BUCKET_THUMBNAILS=pacs-thumbnails
RUSTFS_BUCKET_REPORTS=ris-reports-pdf
RUSTFS_BUCKET_DOCUMENTS=ris-documents

# ── Orthanc DICOM server (containerizado) ───────────────────────────────────
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=orthanc
ORTHANC_PASS=orthanc
# Segredo compartilhado Orthanc→backend (webhook de estudos recebidos do equipamento).
# 16+ caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ORTHANC_WEBHOOK_SECRET=GERE_UM_SEGREDO_FORTE_COM_16_OU_MAIS_CARACTERES

# ── Email (Resend SaaS) ─────────────────────────────────────────────────────
# Obter chave em https://resend.com
# RESEND_API_KEY=re_SUA_CHAVE   # descomente SÓ com chave real; sem ela e-mails não são enviados (e lembretes ficam 'skipped')
EMAIL_FROM="RIS/PACS <noreply@seu-dominio.com>"

# ── Rate limit ──────────────────────────────────────────────────────────────
# O limite é por USUÁRIO/conta (não por IP — atrás do NAT da prefeitura todos
# compartilham o mesmo IP). Painel TV e sala de teleconsulta ficam fora do global.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
# Login: tentativas que FALHAM por (IP + CPF/e-mail/usuário) e por IP, em 15 min.
AUTH_RATE_LIMIT_MAX=10
AUTH_IP_RATE_LIMIT_MAX=100
# Portal do paciente: leituras por conta em 15 min.
PORTAL_RATE_LIMIT_MAX=600

# ── Teleconsulta (WebRTC) ────────────────────────────────────────────────────
# Vazio = só rede local: médico e paciente precisam estar na MESMA rede (sem internet, sem STUN).
# Paciente em casa exige STUN/TURN e o servidor acessível de fora (ver docs/manuais/medico.md):
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.seu-dominio.gov.br:3478","username":"usuario","credential":"senha"}]
ICE_SERVERS=[]

# ── Misc ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
LOG_LEVEL=info
# Logs vão para o console (docker compose logs backend). Arquivo com rotação é opcional:
# LOG_TO_FILE=true
# LOG_DIR=logs

# ── Frontend Vite ───────────────────────────────────────────────────────────
# Nome da clínica usado como watermark nas imagens exportadas pelo OrthoVis.
VITE_CLINIC_NAME=RIS / PACS
