{
  "name": "ris-pacs-backend",
  "version": "1.0.0",
  "description": "RIS/PACS Backend API — Node.js + Express + PostgreSQL",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "bootstrap": "node scripts/bootstrap.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.9",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dicom-parser": "^1.8.21",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.12.0",
    "puppeteer": "^25.12.0",
    "resend": "^4.0.0",
    "speakeasy": "^2.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/setup/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/tests/setup/setupEnv.js"
    ],
    "testTimeout": 30000
  }
}
